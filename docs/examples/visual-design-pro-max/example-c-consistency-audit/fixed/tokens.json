{
  "$schema": "https://design-tokens.org/schema.json",
  "$extensions": {
    "vdp": {
      "platformUnit": "px",
      "minTouchTarget": 44,
      "motionClass": "bouncy",
      "generatedFrom": "fixture-cute-puzzle",
      "fontFamilies": ["Nunito", "Fredoka"],
      "iconLibrary": "material"
    }
  },
  "primitive": {
    "color": {
      "brand": {
        "500": { "$value": "#3B5BDB", "$type": "color" },
        "600": { "$value": "#2F49B8", "$type": "color" }
      },
      "violet": { "500": { "$value": "#845EF7", "$type": "color" } },
      "orange": { "500": { "$value": "#FF8A4C", "$type": "color" } },
      "cream": { "50": { "$value": "#FFF8F0", "$type": "color" }, "200": { "$value": "#E6DCD2", "$type": "color" } },
      "ink": { "900": { "$value": "#1A1A2E", "$type": "color" }, "500": { "$value": "#6B6B80", "$type": "color" } },
      "green": { "500": { "$value": "#2FB36A", "$type": "color" } },
      "yellow": { "500": { "$value": "#F5B800", "$type": "color" }, "300": { "$value": "#FFD43B", "$type": "color" } },
      "red": { "500": { "$value": "#E03E3E", "$type": "color" } },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    },
    "spacing": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension" },
      "md": { "$value": "8px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "pill": { "$value": "9999px", "$type": "dimension" }
    },
    "outline": { "width": { "$value": "3px", "$type": "dimension" } },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "sm": { "$value": "0 2px 8px rgba(0,0,0,0.10)", "$type": "shadow" },
      "md": { "$value": "0 4px 4px rgba(0,0,0,0.20)", "$type": "shadow" }
    },
    "fontSize": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "display": { "$value": "32px", "$type": "dimension" }
    },
    "fontFamily": {
      "display": { "$value": "Fredoka", "$type": "fontFamily" },
      "body": { "$value": "Nunito", "$type": "fontFamily" }
    },
    "lineHeight": { "tight": { "$value": "1.2", "$type": "number" }, "base": { "$value": "1.5", "$type": "number" } },
    "iconSize": { "sm": { "$value": "16px", "$type": "dimension" }, "md": { "$value": "24px", "$type": "dimension" } },
    "touchTarget": { "min": { "$value": "44px", "$type": "dimension" } },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "350ms", "$type": "duration" }
    },
    "easing": { "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" } },
    "zIndex": { "overlay": { "$value": "100", "$type": "number" } },
    "opacity": { "disabled": { "$value": "0.4", "$type": "number" }, "overlay": { "$value": "0.6", "$type": "number" } }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{primitive.color.brand.500}", "$type": "color" },
      "onPrimary": { "$value": "{primitive.color.white}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.violet.500}", "$type": "color" },
      "onSecondary": { "$value": "{primitive.color.white}", "$type": "color" },
      "accent": { "$value": "{primitive.color.orange.500}", "$type": "color" },
      "onAccent": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "background": { "$value": "{primitive.color.cream.50}", "$type": "color" },
      "surface": { "$value": "{primitive.color.white}", "$type": "color" },
      "surfaceElevated": { "$value": "{primitive.color.white}", "$type": "color" },
      "border": { "$value": "{primitive.color.cream.200}", "$type": "color" },
      "overlay": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "text": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "textMuted": { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "success": { "$value": "{primitive.color.green.500}", "$type": "color" },
      "warning": { "$value": "{primitive.color.yellow.500}", "$type": "color" },
      "danger": { "$value": "{primitive.color.red.500}", "$type": "color" },
      "reward": { "$value": "{primitive.color.yellow.300}", "$type": "color" }
    },
    "state": {
      "hover": { "$value": "opacity 0.92", "$type": "string" },
      "pressed": { "$value": "offset 2px", "$type": "string" },
      "focus": { "$value": "outline 3px {primitive.color.brand.500}", "$type": "string" },
      "disabled": { "$value": "opacity {primitive.opacity.disabled}", "$type": "string" }
    },
    "typography": {
      "display": { "fontFamily": { "$value": "{primitive.fontFamily.display}", "$type": "fontFamily" } },
      "body": { "fontFamily": { "$value": "{primitive.fontFamily.body}", "$type": "fontFamily" } }
    }
  },
  "component": {
    "button": {
      "primary": {
        "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
        "shadow": { "$value": "{primitive.shadow.md}", "$type": "shadow" }
      }
    }
  }
}
